{
  "openapi": "3.1.0",
  "info": {
    "title": "Lexidraw API",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "/api/v1"
    }
  ],
  "paths": {
    "/me": {
      "get": {
        "operationId": "auth-me",
        "summary": "The user and scope the request resolves to",
        "tags": ["auth"],
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [],
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "userId": {
                      "type": "string"
                    },
                    "email": {
                      "type": ["string", "null"]
                    },
                    "authKind": {
                      "type": "string",
                      "enum": ["session", "token"]
                    },
                    "scope": {
                      "anyOf": [
                        {
                          "type": "string",
                          "enum": ["read", "write"]
                        },
                        {
                          "type": "null"
                        }
                      ]
                    }
                  },
                  "required": ["userId", "email", "authKind", "scope"],
                  "additionalProperties": false
                }
              }
            }
          },
          "401": {
            "description": "Authorization not provided",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/error.UNAUTHORIZED"
                }
              }
            }
          }
        }
      }
    },
    "/entities/{id}": {
      "get": {
        "operationId": "entities-load",
        "summary": "Load one entity",
        "tags": ["entities"],
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "schema": {
              "type": "string"
            },
            "required": true
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string"
                    },
                    "title": {
                      "type": "string"
                    },
                    "appState": {
                      "type": ["string", "null"]
                    },
                    "elements": {
                      "type": "string"
                    },
                    "publicAccess": {
                      "type": "string",
                      "enum": ["READ", "PRIVATE", "EDIT"]
                    },
                    "sharedWith": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "userId": {
                            "type": "string"
                          },
                          "accessLevel": {
                            "type": "string"
                          }
                        },
                        "required": ["userId", "accessLevel"],
                        "additionalProperties": false
                      }
                    },
                    "accessLevel": {
                      "type": "string",
                      "enum": ["READ", "EDIT"]
                    }
                  },
                  "required": [
                    "id",
                    "title",
                    "appState",
                    "elements",
                    "publicAccess",
                    "sharedWith",
                    "accessLevel"
                  ],
                  "additionalProperties": false
                }
              }
            }
          },
          "401": {
            "description": "Authorization not provided",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/error.UNAUTHORIZED"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "error.UNAUTHORIZED": {
        "type": "object",
        "properties": {
          "message": {
            "type": "string",
            "description": "The error message",
            "example": "Authorization not provided"
          },
          "code": {
            "type": "string",
            "description": "The error code",
            "example": "UNAUTHORIZED"
          },
          "issues": {
            "description": "An array of issues that were responsible for the error",
            "example": [],
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "message": {
                  "type": "string"
                }
              },
              "required": ["message"],
              "additionalProperties": false
            }
          }
        },
        "required": ["message", "code"],
        "additionalProperties": false,
        "title": "Authorization not provided error (401)",
        "description": "The error information",
        "example": {
          "code": "UNAUTHORIZED",
          "message": "Authorization not provided",
          "issues": []
        }
      }
    },
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "lxd_ token"
      }
    }
  }
}
