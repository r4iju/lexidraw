{
  "name": "@apps/ios",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "build:reference": "bun build reference/entry.ts --target=browser --format=iife --minify --define 'process.env.NODE_ENV=\"development\"' --outfile reference/dist/lexical-reference.js",
    "codegen": "bun codegen/write.ts",
    "test": "bun test ./codegen && bun run build:reference && swift test",
    "test:ui": "scripts/test-ui.sh",
    "test:corpus": "bun run build:reference && LEXIDRAW_TOKEN=\"${LEXIDRAW_TOKEN:-$(security find-generic-password -s cli/lexidraw -a prod -w)}\" swift test --filter CorpusTests",
    "test:ts": "tsgo --noEmit && tsgo --noEmit --project codegen && tsgo --noEmit --project recording",
    "lint": "bun x @biomejs/biome check .",
    "record:composition": "bun recording/composition.ts"
  },
  "dependencies": {
    "@lexical/headless": "^0.51.0",
    "@lexical/history": "^0.51.0",
    "@packages/lexical-nodes": "workspace:*",
    "lexical": "^0.51.0"
  },
  "devDependencies": {
    "@types/bun": "1.3.0",
    "@typescript/native-preview": "^7.0.0-dev.20260707.2",
    "puppeteer": "^25.11.0",
    "typescript": "^7.0.2",
    "zod": "^4.6.5"
  }
}
