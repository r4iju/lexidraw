{
  "name": "@apps/ios",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "build:reference": "bun build reference/entry.ts --target=browser --format=iife --minify --define 'process.env.NODE_ENV=\"development\"' --outfile reference/dist/lexical-reference.js",
    "codegen": "bun codegen/write.ts",
    "test": "bun test ./codegen && bun run build:reference && swift test",
    "test:ui": "scripts/test-ui.sh",
    "test:drawing-ui": "scripts/test-drawing-ui.sh",
    "measure:scroll": "scripts/measure-scroll.sh",
    "test:corpus": "bun run build:reference && LEXIDRAW_TOKEN=\"${LEXIDRAW_TOKEN:-$(security find-generic-password -s cli/lexidraw -a prod -w)}\" swift test --filter CorpusTests",
    "test:ts": "tsgo --noEmit && tsgo --noEmit --project codegen && tsgo --noEmit --project recording && tsgo --noEmit --project measure",
    "lint": "bun x @biomejs/biome check .",
    "record:composition": "TEST_RUNNER_RECORD_COMPOSITION=1 scripts/test-ui.sh -only-testing:EditorUITests/EditorUITests/testJapaneseCompositionSavesWhatTheWebEditorSaves && bun recording/composition.ts",
    "record:drawings": "bun run reference/drawings/record.ts"
  },
  "dependencies": {
    "@lexical/clipboard": "^0.51.0",
    "@lexical/extension": "^0.51.0",
    "@lexical/headless": "^0.51.0",
    "@lexical/history": "^0.51.0",
    "@lexical/link": "^0.51.0",
    "@lexical/list": "^0.51.0",
    "@lexical/markdown": "^0.51.0",
    "@lexical/rich-text": "^0.51.0",
    "@lexical/selection": "^0.51.0",
    "@packages/lexical-nodes": "workspace:*",
    "@packages/types": "workspace:*",
    "lexical": "^0.51.0"
  },
  "devDependencies": {
    "@excalidraw/excalidraw": "^0.18.1",
    "@packages/dev-stack": "workspace:*",
    "@types/bun": "1.3.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@typescript/native-preview": "^7.0.0-dev.20260707.2",
    "playwright": "1.62.1",
    "postcss": "^8.5.28",
    "puppeteer": "^25.11.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "typescript": "^7.0.2",
    "zod": "^4.6.5"
  }
}
