{
  "name": "@packages/drawing-widget",
  "version": "0.0.1",
  "license": "MIT",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "scripts": {
    "build": "bun run scripts/build.ts",
    "lint": "bun x @biomejs/biome check --write .",
    "test:ts": "bun x tsgo --noEmit --project tsconfig.json",
    "clean": "rm -rf ./dist && rm -rf .turbo && rm -rf node_modules",
    "test": "bun test"
  },
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./dist/protocol.js"
    },
    "./html": {
      "types": "./src/html.ts",
      "default": "./dist/html.js"
    }
  },
  "files": [
    "dist"
  ],
  "dependencies": {
    "@excalidraw/excalidraw": "^0.18.1",
    "@modelcontextprotocol/ext-apps": "2.0.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@types/bun": "1.3.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@typescript/native-preview": "^7.0.0-dev.20260707.2",
    "playwright": "1.62.1",
    "typescript": "^7.0.2"
  }
}
