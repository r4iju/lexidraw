{
  "name": "@packages/drizzle",
  "version": "0.0.1",
  "license": "MIT",
  "private": true,
  "scripts": {
    "dev": "bun x tsgo --watch --project tsconfig.json",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:pull": "drizzle-kit introspect",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio --port 3100",
    "postinstall": "# drizzle-kit generate",
    "build": "bun x tsgo --project tsconfig.json",
    "lint": "bun x @biomejs/biome check --write .",
    "test:ts": "bun x tsgo --noEmit --project tsconfig.json",
    "clean": "rm tsconfig.tsbuildinfo && rm -rf ./dist && rm -rf .turbo && rm -rf node_modules"
  },
  "sideEffects": false,
  "type": "module",
  "exports": {
    ".": "./dist/index.js",
    "./*": [
      "./dist/*.js",
      "./dist/*/index.js"
    ]
  },
  "dependencies": {
    "@libsql/client": "^0.18.0",
    "@libsql/linux-x64-gnu": "0.5.29",
    "@packages/env": "workspace:*",
    "@paralleldrive/cuid2": "^3.3.0",
    "drizzle-orm": "^0.45.3"
  },
  "devDependencies": {
    "@packages/types": "workspace:*",
    "@types/node": "^22.20.4",
    "@typescript/native-preview": "^7.0.0-dev.20260707.2",
    "dotenv-cli": "latest",
    "drizzle-kit": "^0.31.11"
  },
  "typesVersions": {
    "*": {
      "*": [
        "src/*",
        "src/*/index"
      ]
    }
  },
  "publishConfig": {
    "typesVersions": {
      "*": {
        "*": [
          "dist/*.d.ts",
          "dist/*/index.d.ts"
        ]
      }
    }
  },
  "files": [
    "dist"
  ]
}
