{
  "name": "@packages/lexical-nodes",
  "version": "0.0.1",
  "license": "MIT",
  "private": true,
  "scripts": {
    "dev": "bun x tsgo --watch --project tsconfig.json",
    "build": "bun x tsgo --project tsconfig.build.json",
    "lint": "bun x @biomejs/biome check --write .",
    "test:ts": "bun x tsgo --noEmit --project tsconfig.json",
    "test": "bun test",
    "clean": "rm tsconfig.tsbuildinfo && rm -rf ./dist && rm -rf .turbo && rm -rf node_modules"
  },
  "sideEffects": false,
  "type": "module",
  "exports": {
    ".": "./dist/index.js",
    "./*": [
      "./dist/*.js",
      "./dist/*/index.js"
    ]
  },
  "dependencies": {
    "@lexical/code": "^0.51.0",
    "@lexical/extension": "^0.51.0",
    "@lexical/link": "^0.51.0",
    "@lexical/list": "^0.51.0",
    "@lexical/mark": "^0.51.0",
    "@lexical/markdown": "^0.51.0",
    "@lexical/rich-text": "^0.51.0",
    "@lexical/table": "^0.51.0",
    "@lexical/utils": "^0.51.0",
    "lexical": "^0.51.0"
  },
  "typesVersions": {
    "*": {
      "*": [
        "src/*",
        "src/*/index"
      ]
    }
  },
  "publishConfig": {
    "typesVersions": {
      "*": {
        "*": [
          "dist/*.d.ts",
          "dist/*/index.d.ts"
        ]
      }
    }
  },
  "files": [
    "dist"
  ],
  "devDependencies": {
    "@lexical/headless": "^0.51.0",
    "@types/bun": "1.3.0",
    "@types/node": "^22.20.4",
    "@typescript/native-preview": "^7.0.0-dev.20260707.2",
    "typescript": "^7.0.2"
  }
}
