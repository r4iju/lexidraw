{
  "$schema": "https://biomejs.dev/schemas/2.5.14/schema.json",
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2
  },
  "javascript": {
    "formatter": {
      "enabled": true,
      "quoteStyle": "double",
      "jsxQuoteStyle": "double",
      "semicolons": "always",
      "lineWidth": 80,
      "trailingCommas": "all"
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true,
      "performance": {
        "noImgElement": "off"
      },
      "style": {
        "noDescendingSpecificity": "off"
      }
    }
  },
  "files": {
    "includes": [
      "**",
      "!**/.claude",
      "!**/.next",
      "!**/.build",
      "!apps/ios/Tests/**/Fixtures",
      "!apps/ios/EditorUITests/Fixtures",
      "!packages/lexical-nodes/node-schema.json",
      "!packages/lexical-nodes/test/stored-bytes.json",
      "!**/dist",
      "!**/coverage",
      "!apps/lexidraw/public/scripts",
      "!apps/lexidraw/public/excalidraw-assets",
      "!apps/lexidraw/src/styles/globals.css",
      "!postcss.config.js",
      "!tailwind.config.cjs",
      "!**/drizzle.config.ts",
      "!**/migrate.ts",
      "!**/prettier.config.mjs",
      "!**/.turbo",
      "!**/node_modules",
      "!**/build",
      "!**/.vercel",
      "!**/*.svg",
      "!**/.well-known/workflow"
    ]
  },
  "assist": {
    "enabled": true,
    "actions": {
      "source": {
        "recommended": true,
        "organizeImports": "off"
      }
    }
  },
  "overrides": [
    {
      "includes": ["packages/lexical-nodes/src/nodes/**"],
      "linter": {
        "rules": {
          "complexity": {
            "noThisInStatic": "off"
          }
        }
      }
    },
    {
      "includes": ["apps/code-runner/public/**"],
      "linter": {
        "rules": {
          "suspicious": {
            "noRedundantUseStrict": "off"
          }
        }
      }
    }
  ]
}
